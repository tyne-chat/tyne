msgstr "คนที่ถูกกล่าวถึง"

#. A community command counter counts per person who runs it.
#. Button inserting the placeholder for the member who runs the command.
msgid "Person running it"
msgstr "ผู้ที่เรียกใช้"

#. Name shown in the persona preview card before a name is entered
msgid "Persona"
msgstr "Persona"

#. System message after /persona selects the persona {name}
msgid "Persona \"{name}\" selected."
msgstr "เลือก Persona \"{name}\" แล้ว"

