#. placeholder {0}: w.prefix
msgid "(Prefix: {0})"
msgstr "(Tiền tố: {0})"

#. Install step on Linux for .deb and .rpm packages.
msgid "<0>.deb or .rpm:</0> open the file you downloaded and click <1>Install</1>."
msgstr "<0>.deb hoặc .rpm:</0> mở tệp bạn đã tải xuống và nhấp vào <1>Cài đặt</1>."

#. Install step on Linux for the AppImage.
msgid "<0>AppImage:</0> right-click it, open <1>Properties</1> and allow it to run as a program."
msgstr "<0>AppImage:</0> nhấp chuột phải vào tệp, mở <1>Thuộc tính</1> và cho phép chạy tệp như một chương trình."

#. Why a member is in the import review. {tag} is a proxy tag, {name} an existing persona
msgid "<0>{tag}</0> already belongs to your persona {name}."
msgstr "<0>{tag}</0> đã thuộc về persona {name} của bạn."

#. Why a member is in the import review. {tag} is a proxy tag, {name} another member of the file
msgid "<0>{tag}</0> is also used by {name} in your file."
msgstr "<0>{tag}</0> cũng được {name} trong tệp của bạn sử dụng."

#. Toast when saving a persona with more than five tag pairs
msgid "A persona can have at most 5 tags"
msgstr "Một persona có thể có tối đa 5 thẻ"

#. Tooltip showing root account username
#. Tooltip showing root account username
msgid "Account: @{username}"
msgstr "Tài khoản: @{username}"

msgid "Active persona cleared"
msgstr "Đã xóa persona đang hoạt động"

msgid "Active persona cleared (sending as root account)"
msgstr "Đã xóa persona đang hoạt động (gửi bằng tài khoản gốc)"

#. Aria label for active persona mode tabs
#. Aria label for active persona mode tabs
#. Title of the setting for how the active persona is chosen
msgid "Active persona mode"
msgstr "Chế độ persona đang hoạt động"

#. placeholder {0}: formData.signatureEmojis.length
msgid "Add Emoji ({0})"
msgstr "Thêm biểu tượng cảm xúc ({0})"

msgid "Add Persona"
msgstr "Thêm persona"

#. placeholder {0}: formData.tags.length
msgid "Add Tag Pair ({0}/5)"
msgstr "Thêm cặp thẻ ({0}/5)"

#. Button that adds a counter to a community command.
msgid "Add counter"
msgstr "Thêm bộ đếm"

msgid "Add signal"
msgstr "Thêm tín hiệu"

#. Accessible label of the checkbox that adds a new member of the import file. {name} is its name
msgid "Add {name}"
msgstr "Thêm {name}"

#. Line of the import result: new personas
msgid "Added"
msgstr "Đã thêm"

#. What happens to the import file's version of a persona in the import review
msgid "Added as a new persona"
msgstr "Được thêm làm persona mới"

#. Example persona name in the display tag preview, as in Alice in Wonderland; use the usual form of the name in your language
msgid "Alice"
msgstr "Alice"

msgid "All Personas"
msgstr "Tất cả persona"

#. Back button on a persona’s full profile, back to the Personas list.
msgid "All personas"
msgstr "Tất cả persona"

#. Heading of the list of every platform on the download page.
msgid "All platforms"
msgstr "Tất cả nền tảng"

#. Section header for all time zones in the timestamp modal.
msgid "All time zones"
msgstr "Tất cả múi giờ"

#. Heading of the QR code box on the download page.
msgid "Also on your phone"
msgstr "Có cả trên điện thoại"

#. Error under the command name field.
msgid "Another command or a built-in command already has this name."
msgstr "Một lệnh khác hoặc một lệnh có sẵn đã dùng tên này."

#. Under the AppImage download button: it works on every other Linux distribution.
msgid "Any other Linux"
msgstr "Mọi bản Linux khác"

#. Which Macs the Tyne app runs on: Macs with an Apple processor, M1 or newer.
msgid "Apple silicon (M1 or newer)"
msgstr "Apple silicon (M1 trở lên)"

#. placeholder {0}: formData.name
msgid "Are you sure you want to delete <0>{0}</0>? This action cannot be undone."
msgstr "Bạn có chắc muốn xóa <0>{0}</0> không? Không thể hoàn tác hành động này."

#. Settings search synonym.
msgid "Auto-hide"
msgstr "Tự động ẩn"

#. Settings section label in Advanced Settings for edge hover peek preference.
#. Short label for an advanced appearance preference that reveals collapsed sidebars on mouse hover.
msgid "Auto-peek hidden sidebars"
msgstr "Tự động hiện các thanh bên đã ẩn"

#. Import warning when avatar fails to download
msgid "Avatar image failed to download: {error}. Persona was imported without an avatar."
msgstr "Không tải được ảnh đại diện: {error}. Persona đã được nhập mà không có ảnh đại diện."

#. Import warning when the file's avatar for an existing persona fails to download, so the old one stays
msgid "Avatar image failed to download: {error}. The persona kept the avatar it had."
msgstr "Không tải được ảnh đại diện: {error}. Persona vẫn giữ ảnh đại diện cũ."

#. Explanation of the "Restored" line of the import result
msgid "Back as they were, with their old messages."
msgstr "Trở lại như cũ, cùng với các tin nhắn cũ."

#. Button on narrow screens that returns to the command list.
msgid "Back to commands"
msgstr "Quay lại danh sách lệnh"

#. Accessible label of the arrow-only back button in a narrow settings dialog, shown while one permission override is open. {section} is the settings section it returns to, such as "Permissions".
msgid "Back to {section}"
msgstr "Quay lại {section}"

#. Import warning when a persona banner fails to download
msgid "Banner image failed to download: {error}. Persona was imported without a banner."
msgstr "Không tải được ảnh bìa: {error}. Persona đã được nhập mà không có ảnh bìa."

#. Import warning when the file's banner for an existing persona fails to download, so the old one stays
msgid "Banner image failed to download: {error}. The persona kept the banner it had."
msgstr "Không tải được ảnh bìa: {error}. Persona vẫn giữ ảnh bìa cũ."

#. Option of the switch on a deleted persona in the import review: it is restored
msgctxt "persona-import-switch"
msgid "Bring back"
msgstr "Khôi phục"

#. Badge on a collapsed deleted persona in the import review: it comes back as it was
msgid "Bringing back"
msgstr "Đang khôi phục"

#. Import warning for a restored persona whose proxy tags or signature emojis another persona took meanwhile
#. Import warning for a restored persona whose proxy tags or signature emojis another persona took meanwhile
msgid "Came back without {items}: another persona has them now."
msgstr "Đã trở lại nhưng không có {items}: một persona khác hiện đang dùng chúng."

#. Generic action label that opens the persona picker.
msgid "Change persona"
msgstr "Đổi persona"

#. Help for an example in a command script.
msgid "Change the message depending on what they typed"
msgstr "Đổi tin nhắn tùy theo nội dung họ gõ"

#. Title of the persona import review when no member needs a choice, only the display tag
msgid "Check before importing"
msgstr "Kiểm tra trước khi nhập"

#. Title of the persona import dialog while the file is checked
msgid "Checking your file..."
msgstr "Đang kiểm tra tệp của bạn..."

#. Disabled button while the import file is checked
msgid "Checking..."
msgstr "Đang kiểm tra..."

msgid "Choose a PluralKit export (.json) or a {productName} export (.zip), or drag & drop"
msgstr "Chọn tệp xuất PluralKit (.json) hoặc tệp xuất {productName} (.zip), hoặc kéo và thả"

#. Link on the download page to the list of every platform.
msgid "Choose another platform"
msgstr "Chọn nền tảng khác"

#. Button in one’s own Personas list when none is public; opens persona settings to pick which to make public.
msgid "Choose personas to feature"
msgstr "Chọn persona để giới thiệu"

#. Tooltip on the community command chip when the message box already has text. Preserve {name}.
msgid "Clear the message box to use /{name}"
msgstr "Xóa trống ô tin nhắn để dùng /{name}"

#. Button at the end of the search results panel header. Clears the search and closes the panel.
msgid "Close search"
msgstr "Đóng tìm kiếm"

#. Row heading in the table comparing a persona with the import file
msgid "Colour"
msgstr "Màu"

#. Install step on iPhone. 'Get Tyne in TestFlight' is the button on this page; 'Install' is TestFlight's button.
msgid "Come back here and tap <0>Get Tyne in TestFlight</0>, then <1>Install</1>."
msgstr "Quay lại đây và chạm vào <0>Tải Tyne trong TestFlight</0>, rồi chạm vào <1>Cài đặt</1>."

#. What happens to the app's deleted persona in the import review when it is brought back
msgid "Comes back as it was"
msgstr "Trở lại như cũ"

#. Section label in the command editor: name and description.
msgid "Command"
msgstr "Lệnh"

#. Heading above the count of commands, like "Emoji slots".
msgid "Command slots"
msgstr "Ô lệnh"

#. Community settings tab for the slash commands members of the community can use.
msgctxt "community-settings-tab"
msgid "Commands"
msgstr "Lệnh"

#. Toast after saving the Commands tab.
msgid "Commands saved"
msgstr "Đã lưu lệnh"

#. Status while the import file is compared with the account's personas
msgid "Comparing your file with your personas..."
msgstr "Đang so sánh tệp với các persona của bạn..."

#. Header for configured personas list with count
msgid "Configured Personas ({count})"
msgstr "Persona đã cấu hình ({count})"

#. Explanation of the "Linked" line of the import result
msgid "Connected to their members in the file. Nothing in them changed."
msgstr "Đã kết nối với thành viên tương ứng trong tệp. Không có gì trong chúng thay đổi."

#. Shown at the top of the editor for a new persona that starts as a copy of another; name is the persona it was copied from. Nothing is created until the person presses Create.
msgid "Copy of {name}"
msgstr "Bản sao của {name}"

#. Context menu action to copy a timestamp markdown tag in the message composer.
msgid "Copy timestamp"
msgstr "Sao chép dấu thời gian\\"

#. Toast when downloading the persona export fails
#. Toast when downloading the persona export fails
msgid "Could not export your personas."
msgstr "Không thể xuất các persona của bạn."

#. Shown when the Commands tab fails to load.
msgid "Couldn't load the commands."
msgstr "Không thể tải các lệnh."

#. Shown in the channel when a community command fails (for example slowmode or a missing permission). Preserve {name} and {detail}.
msgid "Couldn't run /{name}: {detail}"
msgstr "Không thể chạy /{name}: {detail}"

#. Toast when saving a command fails. Preserve {name} and {detail}.
msgid "Couldn't save /{name}: {detail}"
msgstr "Không thể lưu /{name}: {detail}"

#. Toast when changing or deleting several personas failed.
msgid "Couldn’t change the personas. Try again."
msgstr "Không thể thay đổi persona. Hãy thử lại."

#. Shown in the Personas list when the request for them failed.
msgid "Couldn’t load personas."
msgstr "Không thể tải persona."

#. Option of a community command counter: a persona counts as its own person, not as its account.
msgid "Count personas separately"
msgstr "Đếm riêng từng persona"

#. Above the choices of what a community command counter keeps its own count for.
msgid "Count separately for each:"
msgstr "Đếm riêng cho mỗi:"

#. Section of a community command that counts how often it was used.
msgid "Counters"
msgstr "Bộ đếm"

#. Permission name: allows creating the community's slash commands and editing one's own.
msgid "Create commands"
msgstr "Tạo lệnh"

#. Permission description in the role editor for the Create commands permission.
msgid "Create commands for this community, and edit or delete your own."
msgstr "Tạo lệnh cho cộng đồng này, và sửa hoặc xóa lệnh của bạn."

#. Under the command editor heading: who made the command. Preserve {name}.
msgid "Created by {name}"
msgstr "Do {name} tạo"

#. When a persona was made, on its card in the Personas list. {date} is a date.
msgid "Created {date}"
msgstr "Đã tạo vào {date}"

#. Aria label for deactivating active persona
msgid "Deactivate persona"
msgstr "Tắt persona"

#. Title of the dialog confirming that a command is deleted. Preserve {name}.
msgid "Delete /{name}?"
msgstr "Xóa /{name}?"

msgid "Delete Persona"
msgstr "Xóa persona"

#. Button that deletes a community command.
msgid "Delete command"
msgstr "Xóa lệnh"

#. Aria label for deleting persona
msgid "Delete persona"
msgstr "Xóa persona"

#. Context menu action to delete a timestamp from the message composer.
msgid "Delete timestamp"
msgstr "Xóa dấu thời gian\\"

#. Title of the confirmation before deleting the selected personas.
msgid "Delete {count, plural, one {# persona} other {# personas}}?"
msgstr "Xóa {count, plural, other {# persona}}?"

#. Title of the section in Settings › Personas that lists deleted personas
msgid "Deleted personas"
msgstr "Persona đã xóa"

#. Explanation of the deleted personas section in Settings › Personas
msgid "Deleted personas still show on their old messages, but nobody can pick them and they don't count towards your limit. Restoring one brings the same persona back, with its history."
msgstr "Persona đã xóa vẫn hiện trên các tin nhắn cũ của chúng, nhưng không ai chọn được và chúng không bị tính vào giới hạn của bạn. Khôi phục một persona sẽ đưa chính persona đó trở lại, cùng với lịch sử của nó."

#. When a persona was deleted, in the import review. {date} is a date
#. When a persona was deleted, in the import review. {date} is a date
msgid "Deleted {date}"
msgstr "Đã xóa ngày {date}"

msgid "Detected System Name / Tag"
msgstr "Tên / thẻ hệ thống đã phát hiện"

#. Title of the display tag setting on the personas settings page
msgid "Display tag"
msgstr "Thẻ hiển thị"

msgid "Display tag will appear next to all persona names in messages. If no display tag is set, your account profile picture will be shown."
msgstr "Thẻ hiển thị sẽ xuất hiện cạnh tất cả tên persona trong tin nhắn. Nếu không có thẻ hiển thị, ảnh đại diện tài khoản của bạn sẽ được hiển thị."

#. Switch in the persona editor. When on, typing one of the persona tags does not switch to this persona.
msgid "Don't match this persona's tags"
msgstr "Không khớp thẻ của persona này"

#. Tooltip hint on timestamp pill in message composer.
msgid "Double-click to edit"
msgstr "Nhấp đúp để chỉnh sửa"

#. Button that downloads the Tyne app as a .deb package for Linux.
msgid "Download .deb"
msgstr "Tải xuống .deb"

#. Button that downloads the Tyne app as an .rpm package for Linux.
msgid "Download .rpm"
msgstr "Tải xuống .rpm"

#. Button that downloads the Tyne app as an AppImage for Linux.
msgid "Download AppImage"
msgstr "Tải xuống AppImage"

#. Button that opens the Tyne download page when the visitor's platform is not known.
msgid "Download Tyne"
msgstr "Tải xuống Tyne"

#. Button that downloads the Tyne app for Android.
#. Button that downloads the Tyne app for Android.
msgid "Download for Android"
msgstr "Tải xuống cho Android"

#. Button that opens the Linux downloads of the Tyne app.
msgid "Download for Linux"
msgstr "Tải xuống cho Linux"

#. Button that downloads the Tyne app for macOS.
#. Button that downloads the Tyne app for macOS.
msgid "Download for Mac"
msgstr "Tải xuống cho Mac"

#. Button that downloads the Tyne app for Windows.
#. Button that downloads the Tyne app for Windows.
msgid "Download for Windows"
msgstr "Tải xuống cho Windows"

#. Progress status during avatar download
msgid "Downloading avatar {current} of {total}..."
msgstr "Đang tải ảnh đại diện {current} trên {total}..."

#. Progress status during banner download in the persona import
msgid "Downloading banner {current} of {total}..."
msgstr "Đang tải ảnh bìa {current} trên {total}..."

#. Button in a persona's editor that starts a new persona as a copy of this one
msgid "Duplicate Persona"
msgstr "Tạo bản sao persona"

#. Toast when saving a persona whose tag pair {tag} (such as "a:text") is listed twice
msgid "Duplicate tag pair \"{tag}\" cannot be listed more than once on the same persona"
msgstr "Cặp thẻ \"{tag}\" không được xuất hiện nhiều lần trên cùng một persona"

#. Validation error when tag pair is duplicated within the same persona
msgid "Duplicate tag pair on this persona"
msgstr "Cặp thẻ bị trùng trên persona này"

#. Helper description for the In Each Channel option of the persona scope setting
msgid "Each channel keeps its own persona. New channels start as your account."
msgstr "Mỗi kênh giữ persona riêng của mình. Kênh mới bắt đầu bằng tài khoản của bạn."

#. Context menu action on the community command chip that opens that command in settings. Preserve {name}.
#. Heading of the command editor. Preserve {name}, the command name.
msgid "Edit /{name}"
msgstr "Sửa /{name}"

#. Title for edit persona modal
msgid "Edit Persona"
msgstr "Chỉnh sửa persona"

#. Permission description in the role editor for the Manage commands permission.
msgid "Edit or delete anyone's commands in this community."
msgstr "Sửa hoặc xóa lệnh của bất kỳ ai trong cộng đồng này."

#. Action button to edit persona
#. Aria label for editing persona
msgid "Edit persona"
msgstr "Chỉnh sửa persona"

#. Context menu action to edit a timestamp in the message composer.
#. Title of the timestamp modal when editing an existing timestamp.
msgid "Edit timestamp"
msgstr "Chỉnh sửa dấu thời gian\\"

msgid "Everyone else"
msgstr "Những người khác"

#. Text under the heading when a reviewed persona import is done
msgid "Everything else is exactly as it was."
msgstr "Mọi thứ khác vẫn giữ nguyên như cũ."

#. Text when a persona import with nothing to decide is done
msgid "Everything in the file was either new or already matched a persona exactly, so there was nothing to decide. Nothing else changed."
msgstr "Mọi thứ trong tệp hoặc là mới, hoặc đã khớp chính xác với một persona, nên không có gì cần quyết định. Không có gì khác thay đổi."

#. Option for where the selected persona applies: one persona for every channel
msgid "Everywhere"
msgstr "Mọi nơi"

msgid "Export Summary"
msgstr "Tóm tắt tệp xuất"

msgid "Failed to clear active persona"
msgstr "Không xóa được persona đang hoạt động"

#. Toast when persona deletion fails
msgid "Failed to delete persona"
msgstr "Không xóa được persona"

#. Toast error message on persona import failure
msgid "Failed to import personas"
msgstr "Không nhập được persona"

#. Error message when parsing PluralKit JSON fails
msgid "Failed to parse JSON file. Please ensure it is a valid PluralKit export."
msgstr "Không phân tích được tệp JSON. Hãy đảm bảo đó là tệp xuất PluralKit hợp lệ."

#. Error message when reading uploaded file fails
msgid "Failed to read the selected file."
msgstr "Không đọc được tệp đã chọn."

#. Toast when persona save fails
msgid "Failed to save persona"
msgstr "Không lưu được persona"

#. Error toast in the community Message Tools settings tab when saving the signal bar fails.
msgid "Failed to save the signal bar. Try again."
msgstr "Không thể lưu thanh tín hiệu. Hãy thử lại."

#. Error toast in the community Message Tools settings tab when saving the channel checkboxes fails.
msgid "Failed to save where the signal bar appears. Try again."
msgstr "Không thể lưu nơi hiển thị thanh tín hiệu. Hãy thử lại."

#. Toast when the chosen animated display tag icon cannot be used
msgid "Failed to select GIF icon"
msgstr "Không chọn được biểu tượng GIF"

#. Toast when the chosen display tag icon image cannot be used
msgid "Failed to select icon image"
msgstr "Không chọn được ảnh biểu tượng"

msgid "Failed to set active persona"
msgstr "Không đặt được persona đang hoạt động"

msgid "Failed to set the persona for this channel"
msgstr "Không đặt được persona cho kênh này"

msgid "Failed to update display tag"
msgstr "Không cập nhật được thẻ hiển thị"

msgid "Failed to update persona mode"
msgstr "Không cập nhật được chế độ persona"

msgid "Failed to update the reaction setting"
msgstr "Không thể cập nhật cài đặt cảm xúc"

msgid "Failed to update where your persona is remembered"
msgstr "Không thay đổi được nơi ghi nhớ persona của bạn"

#. Toast when uploading a persona avatar fails
msgid "Failed to upload avatar image to server"
msgstr "Không tải được ảnh đại diện lên máy chủ"

#. Toast when uploading a persona banner fails
msgid "Failed to upload banner image to server"
msgstr "Không tải được ảnh bìa lên máy chủ"

#. Toast when icon upload fails
msgid "Failed to upload icon to server"
msgstr "Không tải được biểu tượng lên máy chủ"

#. Under the .rpm download button: the Linux distributions that use .rpm packages.
msgid "Fedora, openSUSE"
msgstr "Fedora, openSUSE"

#. Label of the row of chips above the persona list in settings (All, Public, Unlisted, Private).
msgid "Filter by visibility"
msgstr "Lọc theo chế độ hiển thị"

#. Label for format preview selection in timestamp modal.
msgid "Format preview"
msgstr "Xem trước định dạng"

#. Status beside the field for a new proxy tag in the import review: no persona has this tag
msgctxt "persona-import-tag-status"
msgid "Free"
msgstr "Còn trống"

#. Small line on a card in the import review showing a member of the import file
msgid "From your file"
msgstr "Từ tệp của bạn"

#. Link at the end of the command script help to the complete guide on GitHub.
msgid "Full script guide"
msgstr "Hướng dẫn đầy đủ về tập lệnh"

#. Heading of the download page for Android.
msgid "Get Tyne for Android"
msgstr "Tải Tyne cho Android"

#. Heading of the download page for Linux.
msgid "Get Tyne for Linux"
msgstr "Tải Tyne cho Linux"

#. Heading of the download page for macOS.
msgid "Get Tyne for Mac"
msgstr "Tải Tyne cho Mac"

#. Heading of the download page for Windows.
msgid "Get Tyne for Windows"
msgstr "Tải Tyne cho Windows"

#. Button that shows how to install the Tyne app on an iPhone or iPad.
#. Heading of the download page for iPhone and iPad.
msgid "Get Tyne for iPhone"
msgstr "Tải Tyne cho iPhone"

#. Button that opens the Tyne beta in Apple's TestFlight app.
msgid "Get Tyne in TestFlight"
msgstr "Tải Tyne trong TestFlight"

#. Heading of the download page when the visitor's platform is not known.
#. Heading of the panel (and title of the dialog) that offers the Tyne desktop and phone apps.
msgid "Get the Tyne app"
msgstr "Tải ứng dụng Tyne"

#. What happens to the app's version of a persona in the import review when the file's version is used
msgid "Gets overwritten"
msgstr "Bị ghi đè"

#. Heading when a reviewed persona import is done
msgid "Here is what changed"
msgstr "Đây là những gì đã thay đổi"

#. Button that hides the list behind a line at the top of the import review again
msgctxt "persona-import-list"
msgid "Hide"
msgstr "Ẩn"

#. Tooltip on the channel header channel list toggle when the channel list is currently shown.
msgid "Hide channel list"
msgstr "Ẩn danh sách kênh"

#. Tooltip for the small arrow button that collapses the signal bar above the message box.
msgid "Hide signal bar"
msgstr "Ẩn thanh tín hiệu"

#. Label of the field holding the placeholder shown while a member fills the command in.
msgid "Hint"
msgstr "Gợi ý"

#. Settings section description in Advanced Settings for edge hover peek preference.
msgid "Hover near window edges to temporarily reveal collapsed panels."
msgstr "Di chuột gần mép cửa sổ để tạm thời hiện các bảng đã thu gọn."

#. Heading of the install steps on the download page.
msgid "How to install"
msgstr "Cách cài đặt"

#. Toast when icon file exceeds size limit
msgid "Icon file is too large. Choose an image smaller than 10MB."
msgstr "Tệp biểu tượng quá lớn. Hãy chọn ảnh nhỏ hơn 10 MB."

#. Install step on Windows. 'More info' and 'Run anyway' are the links and buttons of Windows' SmartScreen warning: use Windows' own wording in this language.
msgid "If Windows shows this warning, click <0>More info</0>, then <1>Run anyway</1>."
msgstr "Nếu Windows hiện cảnh báo này, hãy nhấp vào <0>Thông tin thêm</0>, rồi nhấp vào <1>Vẫn chạy</1>."

