msgid "{count, plural, one {# member has a tag that is already taken} other {# members have a tag that is already taken}}"
msgstr "{count, plural, one {# üyenin etiketi zaten kullanılıyor} other {# üyenin etiketi zaten kullanılıyor}}"

#. Heading in the import review over the members that share a name or tag with personas of the account
msgid "{count, plural, one {# member might be a persona you already have} other {# members might be personas you already have}}"
msgstr "{count, plural, one {# üye zaten sahip olduğun bir persona olabilir} other {# üye zaten sahip olduğun personalar olabilir}}"

#. Line at the top of the import review. {count} is a number of members of the import file
msgid "{count, plural, one {# new member} other {# new members}}"
msgstr "{count, plural, one {# yeni üye} other {# yeni üye}}"

#. Line at the top of the import review. {count} is a number, {productName} the app name
msgid "{count, plural, one {# persona in {productName} isn't in your file} other {# personas in {productName} aren't in your file}}"
msgstr "{count, plural, one {{productName}’daki # persona dosyanda yok} other {{productName}’daki # persona dosyanda yok}}"

#. Heading in the import review over the list of personas whose details differ from the import file. {count} is how many
msgid "{count, plural, one {# persona is different in your file} other {# personas are different in your file}}"
msgstr "{count, plural, one {# persona dosyanda farklı} other {# persona dosyanda farklı}}"

#. Toast after making personas private; it has an Undo button.
msgid "{count, plural, one {# persona is} other {# personas are}} now private"
msgstr "{count, plural, one {# persona artık gizli} other {# persona artık gizli}}"

#. Toast after making personas public; it has an Undo button.
msgid "{count, plural, one {# persona is} other {# personas are}} now public"
msgstr "{count, plural, one {# persona artık herkese açık} other {# persona artık herkese açık}}"

#. Toast after making personas unlisted; it has an Undo button.
msgid "{count, plural, one {# persona is} other {# personas are}} now unlisted"
msgstr "{count, plural, one {# persona artık liste dışı} other {# persona artık liste dışı}}"

#. Second line of the import review footer
msgid "{count, plural, one {# persona stays as it is} other {# personas stay as they are}}"
msgstr "{count, plural, one {# persona olduğu gibi kalır} other {# persona olduğu gibi kalır}}"

#. Heading in the import review over the members whose persona was deleted. {productName} is the app name
msgid "{count, plural, one {# persona was deleted in {productName}} other {# personas were deleted in {productName}}}"
msgstr "{count, plural, one {{productName}’da # persona silindi} other {{productName}’da # persona silindi}}"

#. How many personas the Personas list shows.
msgid "{count, plural, one {# persona} other {# personas}}"
msgstr "{count, plural, one {# persona} other {# persona}}"

#. Toast after deleting personas.
msgid "{count, plural, one {# persona} other {# personas}} deleted"
msgstr "{count, plural, one {# persona silindi} other {# persona silindi}}"

#. On a collapsed member in the import review: how many personas of the account it might be
msgid "{count, plural, one {# possible match} other {# possible matches}}"
msgstr "{count, plural, one {# olası eşleşme} other {# olası eşleşme}}"

#. Title of the persona import review. {count} is the number of members that need a choice
msgid "{count, plural, one {Check # member before importing} other {Check # members before importing}}"
msgstr "{count, plural, one {İçe aktarmadan önce # üyeyi kontrol et} other {İçe aktarmadan önce # üyeyi kontrol et}}"

#. How often a persona has been used, shown in the import review
#. How often a persona has been used, shown in the import review
msgid "{count, plural, one {Used once} other {Used # times}}"
msgstr "{count, plural, one {Bir kez kullanıldı} other {# kez kullanıldı}}"

msgid "{count} notice(s) during import"
msgstr "İçe aktarma sırasında {count} bildirim"

#. In the "Your reactions" popout: how many of your identities (the account and its personas) reacted, out of all of them. Preserve {count} and {total}.
msgid "{count} of {total}"
msgstr "{count}/{total}"

#. Under the "React as..." title: how many of your identities (the account and its personas) reacted with this emoji, out of all of them. Preserve {count} and {total}.
msgid "{count} of {total} reacted"
msgstr "{count}/{total} tepki verdi"

#. How many personas are selected in settings. Preserve {count}.
msgid "{count} selected"
msgstr "{count} seçildi"

#. Second line of the import review footer: deleted personas that are not restored
msgid "{count} stay deleted"
msgstr "{count} silinmiş kalır"

#. Instance selector error shown when the instance speaks a protocol generation this client does not know. Domain is interpolated. productName is the name of this app.
msgid "{domain} runs a newer version of {productName} than this app. Update {productName}, then try again."
msgstr "{domain} daha yeni bir {productName} sürümü çalıştırıyor. {productName}'ı güncelleyin, sonra tekrar deneyin."

#. Accessible label on a lit signal icon. {label} is the signal name such as Reading, {names} is a comma-separated list of the people who turned it on.
msgid "{label}: {names}"
msgstr "{label}: {names}"

#. A clash in the import review. {label} is a proxy tag or emoji, {names} a list of persona names
msgid "{names} would all have {label}. Change one of the choices."
msgstr "{names} personalarının hepsinde {label} olacak. Seçimlerden birini değiştir."

#. Tooltip when sending as a latched persona
msgid "{name} ({mode}) - Click to switch persona"
msgstr "{name} ({mode}) - Persona değiştirmek için tıkla"

#. Status beside the field for a new proxy tag in the import review. {name} is the persona that has it
msgid "{name} already has it"
msgstr "{name} zaten kullanıyor"

#. Toast after a deleted persona was restored
msgid "{name} is back."
msgstr "{name} geri döndü."

#. Question in the import review for a persona whose details differ from the import file. {name} is its name, {productName} the app name
msgid "{name} is different in your file. Which one should {productName} have?"
msgstr "{name} dosyanda farklı. {productName}’da hangisi olsun?"

#. Problem in a community command script. {name} is a piece of the script, such as {% if target %}. Preserve {name}.
msgid "{name} is never closed."
msgstr "{name} hiç kapatılmıyor."

#. Heading in the import review for a member whose proxy tag another persona or member already has. {name} is its name
msgid "{name}'s tag is already taken"
msgstr "{name} adlı üyenin etiketi zaten kullanılıyor"

#. Which persona of the list is shown, as in "3 of 12". Preserve {position} and {total}.
msgid "{position} of {total}"
msgstr "{position}/{total}"

#. Status shown when browser sign-in status polling gives up after repeated failures. productName is the name of this app.
msgid "{productName} stopped checking whether the browser approved this sign-in. It didn't lose your code."
msgstr "{productName}, tarayıcının bu oturum açma işlemini onaylayıp onaylamadığını kontrol etmeyi bıraktı. Kodunuzu kaybetmedi."

msgid "{publicCount} public, {unlistedCount} unlisted, {privateCount} private"
msgstr "{publicCount} herkese açık, {unlistedCount} liste dışı, {privateCount} gizli"

#. How many personas match the search, out of all shown. Preserve {shown} and {total}.
msgid "{shown} of {total} personas"
msgstr "{shown}/{total} persona"

msgid "— Today at 12:00 PM"
msgstr "— Bugün 12:00"

#. Title of macOS' warning that an app was not opened, drawn on the download page: use macOS' own wording.
msgid "“Tyne” Not Opened"
msgstr "“Tyne” açılmadı"

#. Text in macOS' Privacy & Security settings after an app was blocked: use macOS' own wording.
msgid "“Tyne” was blocked."
msgstr "“Tyne” engellendi."
