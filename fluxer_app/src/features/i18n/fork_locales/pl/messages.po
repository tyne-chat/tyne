#. Community settings tab for choosing the toggleable signal icons shown above the message box.
msgctxt "community-settings-tab"
msgid "Signal Bar"
msgstr "Pasek sygnałów"

#. Accessible label for the row of toggleable signal icons above the message box.
msgid "Signal bar"
msgstr "Pasek sygnałów"

#. Accessible label for the text field that names a signal in the Message Tools settings tab.
msgid "Signal label"
msgstr "Etykieta sygnału"

msgid "Signals are icons above the message box that anyone can switch on and off, and everyone in the conversation sees who has them on. This bar is shared by every community and direct message on this instance. Drag to reorder."
msgstr "Sygnały to ikony nad polem wiadomości, które każdy może włączać i wyłączać, a wszyscy w rozmowie widzą, kto ma je włączone. Ten pasek jest wspólny dla wszystkich społeczności i wiadomości prywatnych na tej instancji. Przeciągnij, aby zmienić kolejność."

msgid "Signature Emojis"
msgstr "Emoji podpisu"

#. Validation error when signature emoji is already used by another persona
msgid "Signature emoji already in use by persona \"{name}\""
msgstr "Emoji podpisu jest już używane przez personę \"{name}\""

#. Row heading in the table comparing a persona with the import file
msgid "Signature emojis"
msgstr "Emoji podpisu"

#. Choice in the import review: do nothing with this member of the import file
msgid "Skip this member"
msgstr "Pomiń tego członka"

#. Line of the import result: members left out
msgid "Skipped"
msgstr "Pominięte"

#. Import warning when member has no name
msgid "Skipped member because they have no name configured."
msgstr "Pominięto członka, ponieważ nie ma skonfigurowanej nazwy."

#. Import warning when a PluralKit member has more or longer proxy tags than a persona can have. Preserve {productName}; it is the app name, inserted by code.
msgid "Some proxy tags were left out: {productName} allows up to 5 per persona, each at most 32 characters."
msgstr "Pominięto niektóre tagi proxy: {productName} pozwala na maksymalnie 5 na personę, każdy o długości do 32 znaków."

#. Line of the import result: deleted personas not restored
msgid "Still deleted"
msgstr "Nadal usunięte"

