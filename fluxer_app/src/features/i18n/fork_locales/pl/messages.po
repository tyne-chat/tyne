#. placeholder {0}: w.prefix
msgid "(Prefix: {0})"
msgstr "(Prefiks: {0})"

#. Why a member is in the import review. {tag} is a proxy tag, {name} an existing persona
msgid "<0>{tag}</0> already belongs to your persona {name}."
msgstr "<0>{tag}</0> należy już do twojej persony {name}."

#. Why a member is in the import review. {tag} is a proxy tag, {name} another member of the file
msgid "<0>{tag}</0> is also used by {name} in your file."
msgstr "<0>{tag}</0> jest też używany przez {name} w twoim pliku."

#. Toast when saving a persona with more than five tag pairs
msgid "A persona can have at most 5 tags"
msgstr "Persona może mieć maksymalnie 5 tagów"

#. Tooltip showing root account username
#. Tooltip showing root account username
msgid "Account: @{username}"
msgstr "Konto: @{username}"

msgid "Active persona cleared"
msgstr "Wyczyszczono aktywną personę"

msgid "Active persona cleared (sending as root account)"
msgstr "Wyczyszczono aktywną personę (wysyłasz jako konto główne)"

#. Aria label for active persona mode tabs
#. Aria label for active persona mode tabs
#. Title of the setting for how the active persona is chosen
msgid "Active persona mode"
msgstr "Tryb aktywnej persony"

#. placeholder {0}: formData.signatureEmojis.length
msgid "Add Emoji ({0})"
msgstr "Dodaj emoji ({0})"

msgid "Add Persona"
msgstr "Dodaj personę"

#. placeholder {0}: formData.tags.length
msgid "Add Tag Pair ({0}/5)"
msgstr "Dodaj parę tagów ({0}/5)"

#. Choice in the import review: add the member as a new persona next to the existing one
msgid "Add as a separate persona"
msgstr "Dodaj jako osobną personę"

#. Button that adds a counter to a community command.
msgid "Add counter"
msgstr "Dodaj licznik"

msgid "Add signal"
msgstr "Dodaj sygnał"

#. Choice in the import review: add the member with a proxy tag another member of the file has too (that one then needs another choice)
msgid "Add with the tag"
msgstr "Dodaj z tagiem"

#. Choice in the import review: add the member as a new persona without the proxy tags listed in {tags}
msgid "Add without {tags}"
msgstr "Dodaj bez {tags}"

#. Line of the import result: new personas
msgid "Added"
msgstr "Dodane"

#. Example persona name in the display tag preview, as in Alice in Wonderland; use the usual form of the name in your language
msgid "Alice"
msgstr "Alicja"

msgid "All Personas"
msgstr "Wszystkie persony"

#. Back button on a persona’s full profile, back to the Personas list.
msgid "All personas"
msgstr "Wszystkie persony"

#. Section header for all time zones in the timestamp modal.
msgid "All time zones"
msgstr "Wszystkie strefy czasowe"

#. Error under the command name field.
msgid "Another command or a built-in command already has this name."
msgstr "Inne polecenie lub wbudowane polecenie ma już tę nazwę."

#. placeholder {0}: formData.name
msgid "Are you sure you want to delete <0>{0}</0>? This action cannot be undone."
msgstr "Czy na pewno chcesz usunąć <0>{0}</0>? Tej czynności nie można cofnąć."

#. Settings search synonym.
msgid "Auto-hide"
msgstr "Ukrywaj automatycznie"

#. Settings section label in Advanced Settings for edge hover peek preference.
#. Short label for an advanced appearance preference that reveals collapsed sidebars on mouse hover.
msgid "Auto-peek hidden sidebars"
msgstr "Automatycznie pokazuj ukryte paski boczne"

#. Import warning when avatar fails to download
msgid "Avatar image failed to download: {error}. Persona was imported without an avatar."
msgstr "Nie udało się pobrać obrazu awatara: {error}. Persona została zaimportowana bez awatara."

#. Import warning when the file's avatar for an existing persona fails to download, so the old one stays
msgid "Avatar image failed to download: {error}. The persona kept the avatar it had."
msgstr "Nie udało się pobrać obrazu awatara: {error}. Persona zachowała dotychczasowy awatar."

#. Explanation of the "Restored" line of the import result
msgid "Back as they were, with their old messages."
msgstr "Wróciły takie, jakie były, razem z dawnymi wiadomościami."

#. Button on narrow screens that returns to the command list.
msgid "Back to commands"
msgstr "Wróć do poleceń"

#. Accessible label of the arrow-only back button in a narrow settings dialog, shown while one permission override is open. {section} is the settings section it returns to, such as "Permissions".
msgid "Back to {section}"
msgstr "Wróć: {section}"

#. Import warning when a persona banner fails to download
msgid "Banner image failed to download: {error}. Persona was imported without a banner."
msgstr "Nie udało się pobrać obrazu banera: {error}. Persona została zaimportowana bez banera."

#. Import warning when the file's banner for an existing persona fails to download, so the old one stays
msgid "Banner image failed to download: {error}. The persona kept the banner it had."
msgstr "Nie udało się pobrać obrazu banera: {error}. Persona zachowała dotychczasowy baner."

#. Import warning for a restored persona whose proxy tags or signature emojis another persona took meanwhile
#. Import warning for a restored persona whose proxy tags or signature emojis another persona took meanwhile
msgid "Came back without {items}: another persona has them now."
msgstr "Wróciła bez {items}: ma je teraz inna persona."

#. Comparison of a persona picture with the import file: it can't be compared
msgid "Can't compare"
msgstr "Nie można porównać"

#. Short name of a section of the import review
msgid "Can't tell"
msgstr "Niepewne"

#. Section of the import review
msgid "Can't tell if it's the same persona"
msgstr "Nie wiadomo, czy to ta sama persona"

#. Generic action label that opens the persona picker.
msgid "Change persona"
msgstr "Zmień personę"

#. Help for an example in a command script.
msgid "Change the message depending on what they typed"
msgstr "Zmień wiadomość zależnie od tego, co wpisano"

#. Title of the persona import dialog while the file is checked
msgid "Checking your file..."
msgstr "Sprawdzanie pliku..."

#. Disabled button while the import file is checked
msgid "Checking..."
msgstr "Sprawdzanie..."

msgid "Choose a PluralKit export (.json) or a {productName} export (.zip), or drag & drop"
msgstr "Wybierz eksport z PluralKit (.json) lub eksport z {productName} (.zip), albo przeciągnij i upuść"

#. Button in one’s own Personas list when none is public; opens persona settings to pick which to make public.
msgid "Choose personas to feature"
msgstr "Wybierz persony do pokazania"

#. Tooltip on the community command chip when the message box already has text. Preserve {name}.
msgid "Clear the message box to use /{name}"
msgstr "Wyczyść pole wiadomości, aby użyć /{name}"

#. Button at the end of the search results panel header. Clears the search and closes the panel.
msgid "Close search"
msgstr "Zamknij wyszukiwanie"

#. Row heading in the table comparing a persona with the import file
msgid "Colour"
msgstr "Kolor"

#. Section label in the command editor: name and description.
msgid "Command"
msgstr "Polecenie"

#. Heading above the count of commands, like "Emoji slots".
msgid "Command slots"
msgstr "Miejsca na polecenia"

#. Community settings tab for the slash commands members of the community can use.
msgctxt "community-settings-tab"
msgid "Commands"
msgstr "Polecenia"

#. Toast after saving the Commands tab.
msgid "Commands saved"
msgstr "Polecenia zapisane"

#. Button that shows a persona next to its version in the import file
msgid "Compare"
msgstr "Porównaj"

#. Status while the import file is compared with the account's personas
msgid "Comparing your file with your personas..."
msgstr "Porównywanie pliku z twoimi personami..."

#. Header for configured personas list with count
msgid "Configured Personas ({count})"
msgstr "Skonfigurowane persony ({count})"

#. Explanation of the "Linked" line of the import result
msgid "Connected to their members in the file. Nothing in them changed."
msgstr "Połączone z odpowiadającymi im członkami w pliku. Nic się w nich nie zmieniło."

#. Context menu action to copy a timestamp markdown tag in the message composer.
msgid "Copy timestamp"
msgstr "Kopiuj znacznik czasu\\"

#. Toast when downloading the persona export fails
msgid "Could not export your personas."
msgstr "Nie udało się wyeksportować twoich person."

#. Shown when the Commands tab fails to load.
msgid "Couldn't load the commands."
msgstr "Nie udało się wczytać poleceń."

#. Shown in the channel when a community command fails (for example slowmode or a missing permission). Preserve {name} and {detail}.
msgid "Couldn't run /{name}: {detail}"
msgstr "Nie udało się uruchomić /{name}: {detail}"

#. Toast when saving a command fails. Preserve {name} and {detail}.
msgid "Couldn't save /{name}: {detail}"
msgstr "Nie udało się zapisać /{name}: {detail}"

#. Toast when changing or deleting several personas failed.
msgid "Couldn’t change the personas. Try again."
msgstr "Nie udało się zmienić person. Spróbuj ponownie."

#. Shown in the Personas list when the request for them failed.
msgid "Couldn’t load personas."
msgstr "Nie udało się wczytać person."

#. Option of a community command counter: a persona counts as its own person, not as its account.
msgid "Count personas separately"
msgstr "Licz persony osobno"

#. Above the choices of what a community command counter keeps its own count for.
msgid "Count separately for each:"
msgstr "Licz osobno dla każdego:"

#. Section of a community command that counts how often it was used.
msgid "Counters"
msgstr "Liczniki"

#. Permission name: allows creating the community's slash commands and editing one's own.
msgid "Create commands"
msgstr "Tworzenie poleceń"

#. Permission description in the role editor for the Create commands permission.
msgid "Create commands for this community, and edit or delete your own."
msgstr "Twórz polecenia dla tej społeczności oraz edytuj i usuwaj własne."

#. Under the command editor heading: who made the command. Preserve {name}.
msgid "Created by {name}"
msgstr "Utworzone przez {name}"

#. When a persona was made, on its card in the Personas list. {date} is a date.
msgid "Created {date}"
msgstr "Utworzono {date}"

#. Aria label for deactivating active persona
msgid "Deactivate persona"
msgstr "Dezaktywuj personę"

#. Title of the dialog confirming that a command is deleted. Preserve {name}.
msgid "Delete /{name}?"
msgstr "Usunąć /{name}?"

msgid "Delete Persona"
msgstr "Usuń personę"

#. Button that deletes a community command.
msgid "Delete command"
msgstr "Usuń polecenie"

#. Aria label for deleting persona
msgid "Delete persona"
msgstr "Usuń personę"

#. Context menu action to delete a timestamp from the message composer.
msgid "Delete timestamp"
msgstr "Usuń znacznik czasu\\"

#. Title of the confirmation before deleting the selected personas.
msgid "Delete {count, plural, one {# persona} other {# personas}}?"
msgstr "Usunąć {count, plural, one {# personę} few {# persony} many {# person} other {# persony}}?"

#. Short name of a section of the import review
msgid "Deleted"
msgstr "Usunięte"

#. Title of the section in Settings › Personas that lists deleted personas
msgid "Deleted personas"
msgstr "Usunięte persony"

#. Explanation of the deleted personas section in Settings › Personas
msgid "Deleted personas still show on their old messages, but nobody can pick them and they don't count towards your limit. Restoring one brings the same persona back, with its history."
msgstr "Usunięte persony nadal widać przy ich dawnych wiadomościach, ale nikt nie może ich wybrać i nie wliczają się do twojego limitu. Przywrócenie persony przywraca tę samą personę razem z jej historią."

#. When a persona was deleted, in the import review. {date} is a date
#. When a persona was deleted, in the import review. {date} is a date
msgid "Deleted {date}"
msgstr "Usunięto {date}"

msgid "Detected System Name / Tag"
msgstr "Wykryta nazwa / tag systemu"

#. Section of the import review
msgid "Different in your file"
msgstr "Inne w twoim pliku"

#. Comparison of a persona picture with the import file: they differ
msgid "Different picture"
msgstr "Inny obraz"

#. Short name of a section of the import review
msgid "Differs"
msgstr "Różnice"

#. What differs between a persona and the import file. {fields} is a list such as "name, bio"
msgid "Differs: {fields}"
msgstr "Różnice: {fields}"

#. Heading of the display tag choice in the import review
#. Section of the import review
#. Short name of a section of the import review
#. Title of the display tag setting on the personas settings page
msgid "Display tag"
msgstr "Widoczny tag"

msgid "Display tag will appear next to all persona names in messages. If no display tag is set, your account profile picture will be shown."
msgstr "Widoczny tag pojawi się obok nazw wszystkich person w wiadomościach. Jeśli nie ustawiono tagu, zostanie pokazane zdjęcie profilowe twojego konta."

#. Switch in the persona editor. When on, typing one of the persona tags does not switch to this persona.
msgid "Don't match this persona's tags"
msgstr "Nie rozpoznawaj tagów tej persony"

#. Tooltip hint on timestamp pill in message composer.
msgid "Double-click to edit"
msgstr "Kliknij dwukrotnie, aby edytować"

#. Progress status during avatar download
msgid "Downloading avatar {current} of {total}..."
msgstr "Pobieranie awatara {current} z {total}..."

#. Progress status during banner download in the persona import
msgid "Downloading banner {current} of {total}..."
msgstr "Pobieranie banera {current} z {total}..."

#. Toast when saving a persona whose tag pair {tag} (such as "a:text") is listed twice
msgid "Duplicate tag pair \"{tag}\" cannot be listed more than once on the same persona"
msgstr "Para tagów „{tag}” nie może występować więcej niż raz w tej samej personie"

#. Validation error when tag pair is duplicated within the same persona
msgid "Duplicate tag pair on this persona"
msgstr "Zduplikowana para tagów w tej personie"

#. Helper description for the In Each Channel option of the persona scope setting
msgid "Each channel keeps its own persona. New channels start as your account."
msgstr "Każdy kanał zachowuje własną personę. Nowe kanały zaczynają jako twoje konto."

#. Explanation of a section of the import review
msgid "Each of these shares a name or a tag with one of your personas, but not both, so it may be the same character or a different one. Compare them and choose. Skipped members stay in your file for next time."
msgstr "Każdy z nich ma tę samą nazwę albo ten sam tag co jedna z twoich person, ale nie jedno i drugie, więc może to być ta sama postać albo zupełnie inna. Porównaj je i wybierz. Pominięci członkowie zostają w twoim pliku na następny raz."

#. Explanation at the top of the import review
msgid "Each one already has the safest choice picked, so nothing you have changes unless you choose it. Please read every section before importing. The hardest ones are at the top."
msgstr "Dla każdego jest już zaznaczony najbezpieczniejszy wybór, więc nic, co masz, się nie zmieni, chyba że to wybierzesz. Przeczytaj każdą sekcję przed importem. Najtrudniejsze są na górze."

#. Context menu action on the community command chip that opens that command in settings. Preserve {name}.
#. Heading of the command editor. Preserve {name}, the command name.
msgid "Edit /{name}"
msgstr "Edytuj /{name}"

#. Title for edit persona modal
msgid "Edit Persona"
msgstr "Edytuj personę"

#. Permission description in the role editor for the Manage commands permission.
msgid "Edit or delete anyone's commands in this community."
msgstr "Edytuj i usuwaj polecenia każdego w tej społeczności."

#. Action button to edit persona
#. Aria label for editing persona
msgid "Edit persona"
msgstr "Edytuj personę"

#. Context menu action to edit a timestamp in the message composer.
#. Title of the timestamp modal when editing an existing timestamp.
msgid "Edit timestamp"
msgstr "Edytuj znacznik czasu\\"

msgid "Everyone else"
msgstr "Wszyscy pozostali"

#. Text under the heading when a reviewed persona import is done
msgid "Everything else is exactly as it was."
msgstr "Cała reszta jest dokładnie taka, jaka była."

#. Text when a persona import with nothing to decide is done
msgid "Everything in the file was either new or already matched a persona exactly, so there was nothing to decide. Nothing else changed."
msgstr "Wszystko w pliku było albo nowe, albo dokładnie pasowało już do którejś persony, więc nie było nic do zdecydowania. Nic więcej się nie zmieniło."

#. Option for where the selected persona applies: one persona for every channel
msgid "Everywhere"
msgstr "Wszędzie"

msgid "Export Summary"
msgstr "Podsumowanie eksportu"

msgid "Failed to clear active persona"
msgstr "Nie udało się wyczyścić aktywnej persony"

#. Toast when persona deletion fails
msgid "Failed to delete persona"
msgstr "Nie udało się usunąć persony"

#. Toast error message on persona import failure
msgid "Failed to import personas"
msgstr "Nie udało się zaimportować person"

#. Error message when parsing PluralKit JSON fails
msgid "Failed to parse JSON file. Please ensure it is a valid PluralKit export."
msgstr "Nie udało się przetworzyć pliku JSON. Upewnij się, że to prawidłowy eksport z PluralKit."

#. Error message when reading uploaded file fails
msgid "Failed to read the selected file."
msgstr "Nie udało się odczytać wybranego pliku."

#. Toast when persona save fails
msgid "Failed to save persona"
msgstr "Nie udało się zapisać persony"

#. Error toast in the community Message Tools settings tab when saving the signal bar fails.
msgid "Failed to save the signal bar. Try again."
msgstr "Nie udało się zapisać paska sygnałów. Spróbuj ponownie."

#. Error toast in the community Message Tools settings tab when saving the channel checkboxes fails.
msgid "Failed to save where the signal bar appears. Try again."
msgstr "Nie udało się zapisać, gdzie pojawia się pasek sygnałów. Spróbuj ponownie."

#. Toast when the chosen animated display tag icon cannot be used
msgid "Failed to select GIF icon"
msgstr "Nie udało się wybrać ikony GIF"

#. Toast when the chosen display tag icon image cannot be used
msgid "Failed to select icon image"
msgstr "Nie udało się wybrać obrazu ikony"

msgid "Failed to set active persona"
msgstr "Nie udało się ustawić aktywnej persony"

msgid "Failed to set the persona for this channel"
msgstr "Nie udało się ustawić persony dla tego kanału"

msgid "Failed to update display tag"
msgstr "Nie udało się zaktualizować widocznego tagu"

msgid "Failed to update persona mode"
msgstr "Nie udało się zaktualizować trybu persony"

msgid "Failed to update the reaction setting"
msgstr "Nie udało się zaktualizować ustawienia reakcji"

msgid "Failed to update where your persona is remembered"
msgstr "Nie udało się zmienić miejsca, w którym zapamiętywana jest twoja persona"

#. Toast when uploading a persona avatar fails
msgid "Failed to upload avatar image to server"
msgstr "Nie udało się przesłać obrazu awatara na serwer"

#. Toast when uploading a persona banner fails
msgid "Failed to upload banner image to server"
msgstr "Nie udało się przesłać obrazu banera na serwer"

#. Toast when icon upload fails
msgid "Failed to upload icon to server"
msgstr "Nie udało się przesłać ikony na serwer"

#. Label of the row of chips above the persona list in settings (All, Public, Unlisted, Private).
msgid "Filter by visibility"
msgstr "Filtruj według widoczności"

#. Label for format preview selection in timestamp modal.
msgid "Format preview"
msgstr "Podgląd formatu"

#. Link at the end of the command script help to the complete guide on GitHub.
msgid "Full script guide"
msgstr "Pełny przewodnik po skryptach"

#. Heading when a reviewed persona import is done
msgid "Here is what changed"
msgstr "Oto co się zmieniło"

#. Tooltip on the channel header channel list toggle when the channel list is currently shown.
msgid "Hide channel list"
msgstr "Ukryj listę kanałów"

#. Button that hides the comparison of a persona with the import file
msgid "Hide comparison"
msgstr "Ukryj porównanie"

#. Tooltip for the small arrow button that collapses the signal bar above the message box.
msgid "Hide signal bar"
msgstr "Ukryj pasek sygnałów"

#. Label of the field holding the placeholder shown while a member fills the command in.
msgid "Hint"
msgstr "Podpowiedź"

#. Settings section description in Advanced Settings for edge hover peek preference.
msgid "Hover near window edges to temporarily reveal collapsed panels."
msgstr "Najedź kursorem w pobliże krawędzi okna, aby tymczasowo pokazać zwinięte panele."

#. Toast when icon file exceeds size limit
msgid "Icon file is too large. Choose an image smaller than 10MB."
msgstr "Plik ikony jest za duży. Wybierz obraz mniejszy niż 10 MB."

#. Title of the persona import dialog when the import is done
msgid "Import finished"
msgstr "Import zakończony"

#. Title of the persona import dialog
msgid "Import personas"
msgstr "Importuj persony"

#. Summary in the import review footer when every choice leaves things as they are
msgid "Import will change nothing"
msgstr "Import niczego nie zmieni"

#. Summary in the import review footer. {actions} is a list such as "link 17, add 7, skip 3"
msgid "Import will {actions}"
msgstr "Import {actions}"

#. Modal title for PluralKit import step importing
msgid "Importing Personas..."
msgstr "Importowanie person..."

#. Information line in the persona import dialog, above the Import button
msgid "Importing never changes or removes a persona you already have unless you choose it. New members are added straight away. If any member might match or clash with one of your personas, you'll review it before anything is imported."
msgstr "Import nigdy nie zmienia ani nie usuwa persony, którą już masz, chyba że to wybierzesz. Nowi członkowie są dodawani od razu. Jeśli któryś członek może pasować do jednej z twoich person lub z nią kolidować, przejrzysz go, zanim cokolwiek zostanie zaimportowane."

msgid "Importing..."
msgstr "Importowanie..."

#. Option for where the selected persona applies: each channel remembers its own persona
msgid "In each channel"
msgstr "W każdym kanale"

#. Column heading in the import review
msgid "In this app"
msgstr "W tej aplikacji"

#. Explanation of a section of the import review
msgid "In this app each proxy tag belongs to one persona. These members have a tag another persona already has, or that another member of your file has too."
msgstr "W tej aplikacji każdy tag proxy należy do jednej persony. Ci członkowie mają tag, który ma już inna persona albo który ma też inny członek twojego pliku."

#. Column heading in the table comparing a persona with the import file
msgid "In this app now"
msgstr "Teraz w tej aplikacji"

#. Column heading in the import review
#. Column heading in the table comparing a persona with the import file
msgid "In your file"
msgstr "W twoim pliku"

#. Explanation of the "Kept as they were" line of the import result
msgid "Including any that differ from the file, where you kept the version you had."
msgstr "Łącznie z tymi, które różnią się od pliku, ale zostawiono dla nich twoją dotychczasową wersję."

#. Button to insert timestamp into message composer.
msgid "Insert"
msgstr "Wstaw"

#. Button or menu action label in the channel and chat mobile textarea plus bottom sheet. Keep it concise.
#. Plus menu item that opens the dynamic timestamp insertion modal.
#. Plus menu item that opens the dynamic timestamp insertion modal.
#. Title of the timestamp insertion modal.
msgid "Insert timestamp"
msgstr "Wstaw znacznik czasu"

#. Label before the buttons that insert placeholders into a command.
msgid "Insert:"
msgstr "Wstaw:"

#. Why a community command could not run, shown after "Couldn't run /name:".
msgid "Its script has a problem."
msgstr "Jego skrypt ma problem."

#. Choice in the import review: keep the persona as it is in this app, ignoring the import file's version
msgid "Keep this version"
msgstr "Zachowaj tę wersję"

#. Button in the import review: keep every listed persona as it is
msgid "Keep this version for all"
msgstr "Zachowaj tę wersję dla wszystkich"

#. Choice in the import review: keep the display tag {tag}
msgid "Keep yours: {tag}"
msgstr "Zachowaj swój tag: {tag}"

#. Line of the import result: personas left unchanged
msgid "Kept as they were"
msgstr "Pozostawione bez zmian"

#. Choice in the import review for a persona that was deleted: keep it deleted
msgid "Leave deleted"
msgstr "Pozostaw usuniętą"

#. Where a problem is in a community command script. Preserve {line}, {column} and {problem}.
msgid "Line {line}, column {column}: {problem}"
msgstr "Wiersz {line}, kolumna {column}: {problem}"

#. Choice in the import review: connect an existing persona to its member in the import file, changing nothing else
msgctxt "persona-import-choice"
msgid "Link"
msgstr "Połącz"

#. Button in the import review that links every persona listed
msgid "Link all {count}"
msgstr "Połącz wszystkie ({count})"

#. Shown on a persona in the import review that is already connected to a different member
msgid "Linked to another PluralKit member"
msgstr "Połączona z innym członkiem PluralKit"

#. Tooltip on the community command chip when the viewer cannot use that command (not a member of its community, or the command is gone). Preserve {name}.
msgid "Made with /{name}"
msgstr "Utworzone poleceniem /{name}"

msgid "Main account"
msgstr "Konto główne"

#. Button that makes the selected personas private.
msgid "Make private"
msgstr "Ustaw jako prywatne"

#. Button that makes the selected personas public.
msgid "Make public"
msgstr "Ustaw jako publiczne"

#. Button that makes the selected personas unlisted.
msgid "Make unlisted"
msgstr "Ustaw jako niepubliczne"

#. Title of the confirmation before making the selected personas private.
msgid "Make {count, plural, one {# persona} other {# personas}} private?"
msgstr "Ustawić {count, plural, one {# personę jako prywatną} few {# persony jako prywatne} many {# person jako prywatne} other {# persony jako prywatne}}?"

#. Title of the confirmation before making the selected personas public.
msgid "Make {count, plural, one {# persona} other {# personas}} public?"
msgstr "Ustawić {count, plural, one {# personę jako publiczną} few {# persony jako publiczne} many {# person jako publiczne} other {# persony jako publiczne}}?"

msgid "Manage Personas"
msgstr "Zarządzaj personami"

#. OAuth scope description shown on the consent screen for the personas.write scope.
msgid "Manage and create your personas"
